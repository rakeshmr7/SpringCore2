              <constructor-arg index = "2" ref = "emp3"/>
       </bean> -->

       <!-- <bean id = "std1" class = "com.example.spring_core.Student">
              <constructor-arg index = "0" value = "101"/>
              <constructor-arg index = "1" value = "Mahesh"/>
              <constructor-arg index = "2" value = "92"/>
       </bean>
       <bean id = "clg1" class = "com.example.spring_core.College">
              <constructor-arg index = "0" value = "101"/>
              <constructor-arg index = "1" value = "ABC College"/>
              <constructor-arg index = "2" ref = "std1"/>
       </bean> -->

       <!-- Autowiring -->

       <bean id = "engine"  class = "com.example.spring_core.Engine">
        <property name = "id" value = "101"/>
       </bean>

       <bean id = "car1" class = "com.example.spring_core.Car" autowire = "byName">
        <property name = "color" value = "White"/>
        <!-- <property  name="engine" ref="eng1"/> -->
       </bean>

       <!-- Injecting Collections -->

       <!-- List -->
       <bean id = "emp4" class = "com.example.spring_core.Employee">
        <property name = "id" value = "104"/>
        <property  name="name" value="Rakesh"/>
        <property  name="sal" value="400000"/>
        <property name = "projects">
              <list>
                <value>Project A</value>
                <value>Project B</value>
                <value>Project C</value>
              </list>
        </property>
       </bean>

       <!-- Set -->
       <bean id = "emp5" class = "com.example.spring_core.Employee">
        <property name = "id" value = "105"/>
        <property  name="name" value="Ramesh"/>
        <property  name="sal" value="500000"/>
        <property name = "skillSet">
              <set>
                <value>Java</value>
                <value>Spring</value>
                <value>React</value>
              </set>
        </property>
       </bean>

       <!-- Map -->
       <bean id = "std2" class = "com.example.spring_core.Student">
        <property name = "rollno" value = "102"/>
        <property  name="name" value="Suresh"/>
        <property  name="marks" value="88"/>
        <property name = "termMarks">
              <map>
                <entry key = "Term1" value = "85"/>
                <entry key = "Term2" value = "90"/>
                <entry key = "Term3" value = "89"/>
              </map>
        </property>
       </bean>

       <bean id = "item1" class = "com.example.spring_core.Items" scope = "singleton">
        <property name = "itemId" value = "101"/>
        <property  name="itemName" value="Laptop"/>
        <property  name="price" value="50000"/>
       </bean>

       <!-- Inner Beans -->
       <bean id = "dept4" class = "com.example.spring_core.Department">
        <property name = "deptId" value = "104"/>
        <property  name="deptName" value="Finance"/>
        <property name = "emp">
              <bean class = "com.example.spring_core.Employee">
                <property name = "id" value = "106"/>
                <property  name="name" value="Rohit"/>
                <property  name="sal" value="600000"/>
              </bean>
        </property>
       </bean>

       <!-- Bean Life Cycle -->
       <!-- <bean id  = "emp6" class = "com.example.spring_core.Employee" 
                  init-method = "start" destroy-method = "stop">
        <property name = "id" value = "107"/>
        <property  name="name" value="Rahul"/>
        <property  name="sal" value="700000"/>
       </bean> -->

        <!-- Via Annotations -->
        
       <bean id  = "emp7" class = "com.example.spring_core.Employee">
        <property name = "id" value = "108"/>
        <property  name="name" value="Rohit"/>
        <property  name="sal" value="800000"/>
      </bean>

</beans>